# Response headers for Cloudflare Pages. Netlify reads this file too; on Vercel
# the same values go in vercel.json under "headers".
#
# This file is the reason the app moved off GitHub Pages. Pages cannot send
# headers at all, and the one header that matters here - frame-ancestors - is
# IGNORED inside a <meta> CSP by every browser, on purpose. So on Pages there was
# no way to express "these dashboards may embed us and nothing else", which meant
# any page on the internet could put a signed-in Soop in an invisible iframe and
# steer somebody's clicks into it.
#
# js/embed.js also refuses to render when it is framed by a page that is not a
# configured embed. That is a real defence and it stays, but it is script running
# inside the frame; this is the browser refusing to draw the frame at all. Two
# checks, neither relying on the other.

/*
  # WHO MAY EMBED US. Add each dashboard's origin here AND to EMBED_ORIGINS in
  # js/config.js - this one stops the frame being drawn, that one stops the
  # bridge talking to it, and they are answering different questions. A missing
  # entry here is a blank panel; a missing entry there is a panel that loads and
  # never signs anybody in.
  #
  # 'self' is listed so the app can frame itself, which embed-demo.html does.
  # There is deliberately no '*'.
  #
  # >>> EDIT THIS LINE. Append each real dashboard origin, space separated, and
  # >>> keep the trailing semicolon. The two localhost entries are for running
  # >>> embed-demo.html on your own machine and are harmless in production
  # >>> (nothing on the internet can be http://localhost:8098 from a visitor's
  # >>> point of view except software on their own computer, and js/config.js
  # >>> only trusts localhost when Soop itself is being served from localhost).
  # >>> Example once you have a real dashboard:
  # >>>   frame-ancestors 'self' https://dash.jarurat.care http://localhost:8098;
  Content-Security-Policy: frame-ancestors 'self' http://localhost:8098 http://127.0.0.1:8098;

  # The hash names the channel and the message being read, and when embedded the
  # page URL also names the customer. Send the origin and no more.
  Referrer-Policy: strict-origin-when-cross-origin

  # A .js served as text/plain is still executed if a page can be talked into
  # sniffing it. Costs nothing.
  X-Content-Type-Options: nosniff

  # Features this app never uses. Denying them means an injection cannot reach
  # them either, and it shortens the permission list a host's security reviewer
  # has to approve. Note microphone is NOT denied: voice rooms need it, and it is
  # granted per-frame by the embed loader's allow attribute.
  Permissions-Policy: geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), interest-cohort=()

  # allow-popups, not plain same-origin: an OAuth or share popup has to be able
  # to talk back to the page that opened it.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # NOT SET, deliberately:
  #   X-Frame-Options - it has no allowlist. Any value that permits the embed
  #     also permits everything, and any value that blocks an attacker blocks the
  #     dashboards. frame-ancestors is the modern replacement and does the job.
  #   Strict-Transport-Security - correct to add, but it is a commitment about
  #     the whole domain including every subdomain if includeSubDomains is used,
  #     and it is not this file's decision to make for the apex.

# Never let a stale service worker outlive a deploy. The worker itself is
# network-first for its own assets, but the file that DECIDES that has to be
# fresh or a bad version can pin itself in place.
/sw.js
  Cache-Control: no-cache

# The loader is pasted into other people's pages and its URL is how they find the
# app. It has to be able to change without every host editing a script tag.
/embed.js
  Cache-Control: public, max-age=300
