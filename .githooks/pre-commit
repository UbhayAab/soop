#!/bin/sh
# Encoding gate: blocks commits carrying mojibake runs, a UTF-8 BOM or a text
# file that is not valid UTF-8 at all. The cp1252-defaulting writer in some
# concurrent toolchains has struck three times (2026-08-24 repair, 568eebe,
# and a fresh BOM on sw.js 2026-08-25) - periodic sweeps lost, so the repo
# gates instead. Enable once per clone:
#   git config core.hooksPath .githooks
node scripts/fix-encoding.mjs --check
