{
  "id": "./",
  "name": "Soop",
  "short_name": "Soop",
  "description": "Invite-only team chat: channels and voice rooms, threads that stay out of the way, and media that never leaves the app. A Redtree product.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "categories": ["social", "productivity", "business"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "./icons/shot-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Channels, threads and voice" },
    { "src": "./icons/shot-narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Soop on mobile" }
  ],
  "shortcuts": [
    { "name": "Threads", "url": "./#/threads", "description": "Every thread you are part of" },
    { "name": "Search", "url": "./#/search", "description": "Search all messages" }
  ]
}
